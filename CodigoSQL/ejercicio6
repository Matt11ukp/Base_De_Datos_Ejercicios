CREATE TABLE Cliente (
    Id VARCHAR(10) PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL,
    apellidos VARCHAR(50) NOT NULL,
    dirección VARCHAR(100) NOT NULL
);

CREATE TABLE Telefono_celular (
    teléfono VARCHAR(10) PRIMARY KEY,
    id VARCHAR(10) NOT NULL,
    FOREIGN KEY (id) REFERENCES Cliente(Id)
);

CREATE TABLE Producto (
    Código VARCHAR(10) PRIMARY KEY,
    descripción VARCHAR(100) NOT NULL,
    precio DECIMAL(10,2) NOT NULL,
    número_existencias INT NOT NULL
);

CREATE TABLE Compra (
    fecha DATE NOT NULL,
    id VARCHAR(10) NOT NULL,
    código VARCHAR(10) NOT NULL,
    FOREIGN KEY (id) REFERENCES Cliente(Id),
    FOREIGN KEY (código) REFERENCES Producto(Código)
);

CREATE TABLE Proveedor (
    Identificador VARCHAR(10) PRIMARY KEY,
    nombres VARCHAR(50) NOT NULL,
    apellidos VARCHAR(50) NOT NULL,
    dirección VARCHAR(100) NOT NULL,
    provincia VARCHAR(50) NOT NULL
);

CREATE TABLE Num_telefono (
    celular VARCHAR(10) NOT NULL,
    identificador VARCHAR(10) NOT NULL,
    PRIMARY KEY (celular, identificador),
    FOREIGN KEY (identificador) REFERENCES Proveedor(Identificador)
);

CREATE TABLE Suministra (
    código VARCHAR(10) NOT NULL,
    Identificador VARCHAR(10) NOT NULL,
    FOREIGN KEY (código) REFERENCES Producto(Código),
    FOREIGN KEY (Identificador) REFERENCES Proveedor(Identificador)
);
