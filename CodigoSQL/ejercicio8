CREATE TABLE Provincia (
    código VARCHAR(10) PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL
);

CREATE TABLE Destinatario (
    id_destinatario VARCHAR(10) PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL,
    dirección VARCHAR(100) NOT NULL
);

CREATE TABLE Camionero (
    Cédula VARCHAR(10) PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL,
    teléfono VARCHAR(10) NOT NULL,
    dirección VARCHAR(100) NOT NULL
);

CREATE TABLE Paquete (
    código VARCHAR(10) PRIMARY KEY,
    descripción VARCHAR(100) NOT NULL,
    dirección VARCHAR(100) NOT NULL,
    código_provincia VARCHAR(10) NOT NULL,
    id_destinatario VARCHAR(10) NOT NULL,
    cédula VARCHAR(10) NOT NULL,
    FOREIGN KEY (código_provincia) REFERENCES Provincia(código),
    FOREIGN KEY (id_destinatario) REFERENCES Destinatario(id_destinatario),
    FOREIGN KEY (cédula) REFERENCES Camionero(Cédula)
);

CREATE TABLE Camión (
    matrícula VARCHAR(10) PRIMARY KEY,
    modelo VARCHAR(50) NOT NULL,
    potencia VARCHAR(50) NOT NULL,
    tipo VARCHAR(50) NOT NULL,
    cédula VARCHAR(10) NOT NULL,
    FOREIGN KEY (cédula) REFERENCES Camionero(Cédula)
);
